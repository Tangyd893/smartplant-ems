# 数据库配置
DB_USER=spuser
DB_PASS=sp123456
DB_HOST=127.0.0.1:3306
DB_NAME=smartplant_ems

# JWT配置
JWT_SECRET=your-secret-key-change-in-production

# 数据库连接池配置
MAX_IDLE_CONNS=10
MAX_OPEN_CONNS=100

# CORS配置 (生产环境请指定具体域名)
CORS_ALLOWED_ORIGIN=*

# 后端服务地址 (用于Nginx配置)
DEVICE_SERVICE_URL=http://127.0.0.1:8081
ENERGY_SERVICE_URL=http://127.0.0.1:8082
REPORT_SERVICE_URL=http://127.0.0.1:8083